{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "player.json",
  "description": "Player profile. Written by the app (Workstream G).",
  "type": "object",
  "required": [
    "schema_version",
    "player_id",
    "strong_foot",
    "level",
    "height_cm"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "player_id": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "strong_foot": {
      "type": "string",
      "enum": [
        "left",
        "right"
      ]
    },
    "level": {
      "type": "string",
      "enum": [
        "casual",
        "pro"
      ]
    },
    "height_cm": {
      "type": "number",
      "minimum": 100,
      "maximum": 230
    },
    "goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sessions_per_week": {
      "type": "integer",
      "minimum": 1,
      "maximum": 14
    }
  }
}
