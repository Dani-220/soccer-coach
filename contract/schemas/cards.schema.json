{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cards.json",
  "description": "Why-it-matters cards. Written by Workstream F.",
  "type": "object",
  "required": [
    "schema_version",
    "player_id",
    "reps"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "player_id": {
      "type": "string"
    },
    "reps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rep_id",
          "cards"
        ],
        "additionalProperties": false,
        "properties": {
          "rep_id": {
            "type": "string"
          },
          "cards": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "object",
              "required": [
                "metric",
                "headline",
                "measured_value",
                "unit",
                "target",
                "why",
                "fix",
                "drill_ids",
                "frame"
              ],
              "additionalProperties": false,
              "properties": {
                "metric": {
                  "type": "string",
                  "enum": [
                    "plant_foot_distance",
                    "plant_foot_angle",
                    "knee_over_ball",
                    "trunk_lean",
                    "hip_shoulder_separation",
                    "ankle_lock",
                    "follow_through",
                    "ball_speed"
                  ]
                },
                "headline": {
                  "type": "string",
                  "maxLength": 60
                },
                "measured_value": {
                  "type": "number",
                  "description": "Copied from metrics.json, never generated by the LLM."
                },
                "unit": {
                  "type": "string"
                },
                "target": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "why": {
                  "type": "string",
                  "maxLength": 220
                },
                "fix": {
                  "type": "string",
                  "maxLength": 160
                },
                "drill_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                },
                "frame": {
                  "type": "integer",
                  "minimum": 0
                },
                "compare_to_strong_foot": {
                  "type": "number",
                  "description": "Optional: same metric's recent average on the strong foot."
                }
              }
            }
          }
        }
      }
    }
  }
}
